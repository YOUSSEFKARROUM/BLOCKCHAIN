# Copier en .env.local (ignoré par Git).

# Réseau lu par l'interface : 31337 (anvil) ou 11155111 (Sepolia)
NEXT_PUBLIC_CHAIN_ID=31337
# RPC utilisé pour LIRE la blockchain sans MetaMask (anvil local, ou un RPC Sepolia public)
NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8545

# Pinata : JWT utilisé UNIQUEMENT côté serveur (route /api/ipfs), jamais envoyé au navigateur.
# Sans cette clé, l'upload passe en "mode dev local" (fichier stocké sur la machine, non publié sur IPFS).
PINATA_JWT=
# Passerelle IPFS pour lire les métadonnées
IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs/
