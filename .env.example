# Copier ce fichier en .env puis remplir. Le fichier .env est ignoré par Git.
# Ne partagez JAMAIS votre clé privée (ni dans le chat, ni dans le dépôt).

# --- Réseau Sepolia ---
# URL RPC (Alchemy, Infura, ou public : https://ethereum-sepolia-rpc.publicnode.com)
SEPOLIA_RPC_URL=
# Clé privée d'un compte de TEST uniquement (préfixe 0x), avec un peu de SepoliaETH
PRIVATE_KEY=
# Clé API Etherscan (vérification du code source) : https://etherscan.io/myapikey
ETHERSCAN_API_KEY=

# --- Trésorerie multisig 2-sur-3 ---
# Les 3 propriétaires (adresses publiques, pas des clés !). Les 3 membres du trinôme.
TREASURY_OWNER_1=
TREASURY_OWNER_2=
TREASURY_OWNER_3=

# --- Gouvernance ---
# Durée de vote en secondes (3600 = 1 h pour la démo Sepolia ; 259200 = 3 jours en production)
VOTING_PERIOD=3600

# --- IPFS (Pinata) : utilisée côté serveur Next.js uniquement ---
# À mettre dans frontend/.env.local : PINATA_JWT=...
